# Copy this file to config.local.env and fill in your Firebase values.
# Used by scripts/test-firestore-post.ps1 (REST smoke test).
#
# For the web app, copy web/.env.local.example to web/.env.local instead.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_WEB_API_KEY=your-web-api-key

# Firestore REST endpoint (auto-built from above)
# POST/GET: https://firestore.googleapis.com/v1/projects/{FIREBASE_PROJECT_ID}/databases/(default)/documents/smart_sorter_logs?key={FIREBASE_WEB_API_KEY}
