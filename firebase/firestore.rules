rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: PUBLIC ACCESS — LAB / TESTING ONLY
    // Do not use in production. Anyone can read and write all documents.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

